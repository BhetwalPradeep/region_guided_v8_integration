{
  "model_name": "region_guided_v8",
  "architecture": "region_guided_attention",
  "checkpoint_path": "model/checkpoint_best.weights.h5",
  "config_path": "model/config.json",
  "artifact_bucket": "s3://viewray-ai/Patient-vision/Pradeep/Region-aware-v8/",
  "input_shape": [256, 256, 12],
  "output_shape": [5, 2],
  "mask_count": 5,
  "mask_order": ["outer_masks", "body", "arms", "face", "hair"],
  "clinical_convention": {
    "prediction_direction": "fixed_to_moving",
    "registration_direction": "moving_to_fixed",
    "inverse_warp_applied": true,
    "equation": "registered_moving = warp(moving_image, -predicted_dxdy)"
  },
  "inference": {
    "host": "127.0.0.1",
    "port": 5055,
    "socket_enabled": true,
    "fixed_yolo_optional": true,
    "moving_yolo_optional": true,
    "registered_output_optional": true,
    "fallback_yolo_mask": "outer_sapiens_mask"
  },
  "runtime": {
    "dtype": "float32",
    "normalization": "masked_normalization",
    "region_guidance": "five_sapiens_masks",
    "output_units": "pixels"
  },
  "notes": [
    "Training configuration and inference configuration should be reported separately.",
    "The model prediction convention is fixed-to-moving, but clinical use requires inverse warping to moving-to-fixed.",
    "TFRecords are training artifacts; they are not required for runtime inference."
  ]
}
